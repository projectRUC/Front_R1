        >
          <Icon icon={isOpen ? "solar:close-circle-bold-duotone" : "solar:hamburger-menu-linear"} className="w-6 h-6 text-sky-600" />
        </Button>
      </div>

      {/* Overlay para móvil */}
      <AnimatePresence>
        {isOpen && (
          <motion.div
