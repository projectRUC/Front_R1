  const validar = () => {
    if (password.length < MIN_LARGO) {
      return `La contraseña debe tener al menos ${MIN_LARGO} caracteres.`;
    }
    if (password !== confirmacion) {
      return 'Las contraseñas no coinciden.';
    }
    return '';
