  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    const mensajeError = validar();
    setError(mensajeError);
    if (mensajeError) return;

    setIsLoading(true);
    try {
      await authService.cambiarContrasena({ correo, nuevaPassword: password });
      setActualizada(true);
