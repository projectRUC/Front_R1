        setActForm(prev => ({ ...prev, criterios: res.criterios }));
      }
    } catch (error) {
      console.error("Error generando criterios con IA:", error);
      alert("Ocurrió un error al generar los criterios con IA.");
    } finally {
      setLoadingAI(false);
    }
  };

